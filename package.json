{
  "name": "tenkai-console",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint --type-aware",
    "format": "oxfmt --write",
    "test": "vitest run",
    "package": "sh scripts/package.sh",
    "lint:fix": "oxlint --type-aware --fix && pnpm format",
    "format:check": "oxfmt --check",
    "api:sync": "node scripts/api.mjs sync",
    "api:gen": "node scripts/api.mjs gen",
    "api:check": "node scripts/api.mjs check",
    "api:drift": "node scripts/api.mjs drift",
    "perf:bundle": "node scripts/bundle-budget.mjs check",
    "perf:bundle:update": "node scripts/bundle-budget.mjs update",
    "perf:load": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.40",
    "arktype": "^2.2.5",
    "oauth4webapi": "^3.8.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "smol-toml": "^1.9.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "json-schema-to-typescript": "^16.0.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
